# RetailPOS desktop configuration. Generated by the installer on first
# install and NEVER overwritten by upgrades. Contains secrets: the file's
# permissions are restricted to Administrators, SYSTEM and local Users (read).
APP_NAME="RetailPOS"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=http://127.0.0.1
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_SA

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=__DB_PORT__
DB_DATABASE=retail_pos
DB_USERNAME=retailpos
DB_PASSWORD=__DB_PASSWORD__

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
PUBLIC_DISK_SERVE=true
BCRYPT_ROUNDS=12

BACKUP_PATH=__BACKUP_DIR__
PG_DUMP_PATH=__PG_BIN__pg_dump__EXE__
PG_RESTORE_PATH=__PG_BIN__pg_restore__EXE__
PSQL_PATH=__PG_BIN__psql__EXE__
